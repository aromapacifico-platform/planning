{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Sistema de Tokens AromaPacífico",
  "version": "1.0.0",
  "description": "Tokens de diseño oficiales para la plataforma cafetera AromaPacífico (FNC 2026). Optimizados para legibilidad bajo luz solar directa, doble codificación de estados y cumplimiento WCAG 2.1 AAA.",
  "color": {
    "marca": {
      "primario": {
        "base": {
          "$value": "#135E34",
          "$type": "color",
          "$description": "Verde Cordillera / Cafetal. Identidad de sostenibilidad, trazabilidad y rigor agronómico."
        },
        "oscuro": {
          "$value": "#0D4A27",
          "$type": "color",
          "$description": "Verde Acopio Profundo. Usado para texto sobre fondos claros bajo sol intenso."
        },
        "claro": {
          "$value": "#DCFCE7",
          "$type": "color",
          "$description": "Verde Brote / Menta suave. Fondo de contenedores y badges aprobados."
        }
      },
      "secundario": {
        "cereza": {
          "$value": "#9E1B1B",
          "$type": "color",
          "$description": "Rojo Cereza Madura. Calidez, cosecha manual selectiva y alertas."
        },
        "cereza_oscuro": {
          "$value": "#7F1D1D",
          "$type": "color",
          "$description": "Rojo Tostión / Alerta Profunda. Texto de rechazo y alertas fitosanitarias."
        },
        "pacifico": {
          "$value": "#0F4C81",
          "$type": "color",
          "$description": "Azul Pacífico. Ruta marítima Buenaventura, comercio y logística global."
        },
        "pacifico_vibrante": {
          "$value": "#1D4ED8",
          "$type": "color",
          "$description": "Azul Ruta Satelital. Indicador activo de viaje terrestre o marítimo."
        },
        "tierra": {
          "$value": "#4A2E1B",
          "$type": "color",
          "$description": "Marrón Tierra Volcánica. Suelo andino del macizo colombiano (Cauca, Huila, Tolima)."
        }
      },
      "neutro": {
        "carbon": {
          "$value": "#0F172A",
          "$type": "color",
          "$description": "Carbón / Slate 900. Texto primario de ultra-alto contraste (>16:1 contra blanco)."
        },
        "pizarra": {
          "$value": "#334155",
          "$type": "color",
          "$description": "Gris Pizarra. Texto secundario y metadatos de telemetría."
        },
        "borde": {
          "$value": "#CBD5E1",
          "$type": "color",
          "$description": "Gris Borde. Delimitador de tarjetas bajo luz ambiente difusa."
        },
        "niebla": {
          "$value": "#F1F5F9",
          "$type": "color",
          "$description": "Gris Niebla Andina. Fondo de componentes secundarios y tablas."
        },
        "pergamino": {
          "$value": "#FAF8F5",
          "$type": "color",
          "$description": "Blanco Pergamino. Lienzo principal de las aplicaciones, reduce el deslumbramiento ocular."
        },
        "blanco": {
          "$value": "#FFFFFF",
          "$type": "color",
          "$description": "Blanco puro. Superficie de tarjetas y contenedores elevados."
        }
      }
    },
    "estado_saco": {
      "en_preparacion": {
        "texto": { "$value": "#78350F", "$type": "color" },
        "fondo": { "$value": "#FEF3C7", "$type": "color" },
        "borde": { "$value": "#D97706", "$type": "color" },
        "icono": { "$value": "#B45309", "$type": "color" },
        "contraste_wcag": "8.15:1 (Pasa AAA)"
      },
      "en_viaje": {
        "texto": { "$value": "#1E40AF", "$type": "color" },
        "fondo": { "$value": "#DBEAFE", "$type": "color" },
        "borde": { "$value": "#2563EB", "$type": "color" },
        "icono": { "$value": "#1D4ED8", "$type": "color" },
        "contraste_wcag": "7.15:1 (Pasa AAA)"
      },
      "aceptado": {
        "texto": { "$value": "#14532D", "$type": "color" },
        "fondo": { "$value": "#DCFCE7", "$type": "color" },
        "borde": { "$value": "#16A34A", "$type": "color" },
        "icono": { "$value": "#15803D", "$type": "color" },
        "contraste_wcag": "8.30:1 (Pasa AAA)"
      },
      "rechazado": {
        "texto": { "$value": "#7F1D1D", "$type": "color" },
        "fondo": { "$value": "#FEE2E2", "$type": "color" },
        "borde": { "$value": "#DC2626", "$type": "color" },
        "icono": { "$value": "#B91C1C", "$type": "color" },
        "contraste_wcag": "8.20:1 (Pasa AAA)"
      }
    },
    "alerta_cultivo": {
      "foco_critico": {
        "texto": { "$value": "#7F1D1D", "$type": "color" },
        "fondo": { "$value": "#FEF2F2", "$type": "color" },
        "borde": { "$value": "#B91C1C", "$type": "color" },
        "icono": { "$value": "#DC2626", "$type": "color" },
        "contraste_wcag": "9.16:1 (Pasa AAA)",
        "grosor_borde": "2.5px"
      },
      "advertencia_umbral": {
        "texto": { "$value": "#78350F", "$type": "color" },
        "fondo": { "$value": "#FFFBEB", "$type": "color" },
        "borde": { "$value": "#D97706", "$type": "color" },
        "icono": { "$value": "#B45309", "$type": "color" },
        "contraste_wcag": "8.15:1 (Pasa AAA)",
        "grosor_borde": "2px"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "'Fira Code', 'Courier New', monospace",
        "$type": "fontFamily"
      }
    },
    "fontSize": {
      "badge": { "$value": "14px", "$type": "dimension" },
      "cuerpo": { "$value": "16px", "$type": "dimension" },
      "subtitulo": { "$value": "18px", "$type": "dimension" },
      "titulo": { "$value": "24px", "$type": "dimension" },
      "alerta_campo": { "$value": "20px", "$type": "dimension" }
    },
    "fontWeight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" },
      "heavy": { "$value": "800", "$type": "fontWeight" }
    }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "xl": { "$value": "24px", "$type": "dimension" },
    "touch_min": { "$value": "48px", "$type": "dimension", "$description": "Tamano minimo de area tactil ergonomica para caficultores con guantes o dedos mojados." }
  }
}

