<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" compressed="false">
  <diagram id="seguridad-revocacion" name="Procedimiento de Baja y Revocación de Dispositivos">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITULO PRINCIPAL -->
        <mxCell id="title" value="AromaPacífico - Flujo Operativo y Criptográfico de Baja y Revocación de Dispositivos" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="300" y="30" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Procedimiento Paso a Paso de Desactivación de Certificados X.509, Desvinculación de Políticas, Corte mTLS y Verificación de Auditoría WORM" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#5A6B7C;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="1200" height="25" as="geometry" />
        </mxCell>

        <!-- PANEL DE GOBERNANZA SUPERIOR -->
        <mxCell id="sec-gov-rev" value="POLÍTICA DE BAJA Y CONTENCIÓN DE INCIDENTES (Zero Trust Device Decommissioning)&#xa;Invariante de Seguridad: Ante la sospecha de robo físico, daño irreparable o pérdida de custodia, el dispositivo debe ser revocado en menos de 15 minutos.&#xa;&#xa;1. Quién lo solicita: El técnico de campo FNC, agrónomo de zona o piloto de dron emite el reporte de pérdida formal con FincaID o DronID.&#xa;2. Quién lo ejecuta: El Oficial de Ciberseguridad o Ingeniero DevOps FNC mediante sesión autenticada con MFA en AWS IAM Identity Center.&#xa;3. Efecto en Tiempo Real: Desactivación inmediata del certificado X.509; el broker cierra la sesión MQTT y deniega cualquier handshake futuro." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D93F0B;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=15;spacingTop=12;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="115" width="1700" height="110" as="geometry" />
        </mxCell>

        <!-- CONTENEDOR PRINCIPAL: LOS 4 CARRILES DEL PROCEDIMIENTO -->
        <mxCell id="box-swimlanes" value="SECUENCIA DE REVOCACIÓN, CORTE DE TRANSMISIÓN Y VERIFICACIÓN EN CUATRO CARRILES" style="swimlane;startSize=30;horizontal=1;fillColor=#EAEDED;strokeColor=#545B64;strokeWidth=2;rounded=1;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="245" width="1700" height="995" as="geometry" />
        </mxCell>

        <!-- CARRIL 1: CAMPO Y SOLICITANTE -->
        <mxCell id="lane-campo" value="1. Solicitante en Campo (Técnico / Caficultor / Piloto)" style="swimlane;startSize=25;fillColor=#FFFFFF;strokeColor=#0E8A16;strokeWidth=1.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="box-swimlanes">
          <mxGeometry x="25" y="45" width="380" height="925" as="geometry" />
        </mxCell>

        <mxCell id="step-1" value="Paso 1: Detección y Reporte de Pérdida&#xa;&#xa;Eventos Disparadores:&#xa;a. Robo físico de nodo en parcela cafetera.&#xa;b. Extravío / caída de dron en cañón remoto.&#xa;c. Daño estructural por rayo o inundación.&#xa;&#xa;Acción del Solicitante:&#xa;Reporta inmediatamente a la Mesa de Ayuda FNC&#xa;indicando: FincaID / DronID, coordenadas GPS,&#xa;fecha/hora del suceso y motivo de la baja." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#0E8A16;strokeWidth=2;fontSize=12;align=left;spacingLeft=12;fontColor=#232F3E;" vertex="1" parent="lane-campo">
          <mxGeometry x="20" y="45" width="340" height="190" as="geometry" />
        </mxCell>

        <mxCell id="step-5-client" value="Paso 5: Intento de Transmisión del Dispositivo&#xa;&#xa;Comportamiento del Dispositivo Comprometido:&#xa;- El hardware intenta reconectar al broker IoT.&#xa;- Handshake mTLS falla en el Paso 5:&#xa;  Broker responde: TLS Alert - Certificate Revoked&#xa;- Conexión TCP terminada inmediatamente.&#xa;- El dispositivo no puede enviar ni un solo mensaje.&#xa;- La clave privada sustraída queda inútil." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#D93F0B;strokeWidth=2;fontSize=12;align=left;spacingLeft=12;fontColor=#232F3E;" vertex="1" parent="lane-campo">
          <mxGeometry x="20" y="485" width="340" height="195" as="geometry" />
        </mxCell>

        <mxCell id="step-7" value="Paso 7: Aprovisionamiento de Reemplazo&#xa;&#xa;Instalación de Nuevo Hardware:&#xa;- Se asigna un nuevo nodo con FincaID idéntico.&#xa;- Nuevo par de claves y certificado X.509 único.&#xa;- Asociación del nuevo certificado al ThingName.&#xa;- Se preserva el historial agronómico previo.&#xa;- Instalación en campo en una sola visita." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#0E8A16;strokeWidth=2;fontSize=12;align=left;spacingLeft=12;fontColor=#232F3E;" vertex="1" parent="lane-campo">
          <mxGeometry x="20" y="720" width="340" height="180" as="geometry" />
        </mxCell>

        <!-- CARRIL 2: OFICIAL DE SEGURIDAD Y DEVOPS -->
        <mxCell id="lane-sec-ops" value="2. Oficial de Seguridad / DevOps Lead (MFA Obligatorio)" style="swimlane;startSize=25;fillColor=#FFFFFF;strokeColor=#1D76DB;strokeWidth=1.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="box-swimlanes">
          <mxGeometry x="445" y="45" width="390" height="925" as="geometry" />
        </mxCell>

        <mxCell id="step-2" value="Paso 2: Validación de Identidad y Triaje&#xa;&#xa;Acciones del Oficial de Seguridad:&#xa;1. Autenticación en IAM Identity Center con MFA WebAuthn.&#xa;2. Asume el rol AromaPacifico-SecurityOperationsRole.&#xa;3. Verifica la coincidencia del FincaID y su certificado activo.&#xa;4. Obtiene el CertificateId y ARN del principal asociado.&#xa;5. Genera el ticket de incidente INC-SEC-YYYYMMDD-XX." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;align=left;spacingLeft=12;fontColor=#232F3E;" vertex="1" parent="lane-sec-ops">
          <mxGeometry x="20" y="45" width="350" height="170" as="geometry" />
        </mxCell>

        <mxCell id="step-3" value="Paso 3: Ejecución de Comandos de Revocación&#xa;&#xa;Ejecución Atómica vía AWS CLI / Script Automatizado:&#xa;&#xa;1. Desactivar el Certificado:&#xa;   aws iot update-certificate \&#xa;     --certificate-id $CERT_ID \&#xa;     --new-status INACTIVE&#xa;&#xa;2. Desvincular Política de Permisos:&#xa;   aws iot detach-policy \&#xa;     --policy-name AromaPacifico-Node-Policy \&#xa;     --target $CERT_ARN&#xa;&#xa;3. Desvincular Certificado del Thing:&#xa;   aws iot detach-thing-principal \&#xa;     --thing-name FINCA-CAUCA-001 \&#xa;     --principal $CERT_ARN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF3FB;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;fontColor=#232F3E;" vertex="1" parent="lane-sec-ops">
          <mxGeometry x="20" y="240" width="350" height="265" as="geometry" />
        </mxCell>

        <mxCell id="step-6-ops" value="Paso 6: Verificación Activa de Cese de Emisión&#xa;&#xa;Validación Cruzada por el Oficial:&#xa;1. Monitoreo en CloudWatch de la métrica Connect.AuthError.&#xa;2. Consulta a DynamoDB: cero escrituras en últimos 30 min.&#xa;3. Prueba de handshake simulado: conexión rechazada.&#xa;4. Cierre formal del ticket de incidente de seguridad." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;align=left;spacingLeft=12;fontColor=#232F3E;" vertex="1" parent="lane-sec-ops">
          <mxGeometry x="20" y="530" width="350" height="165" as="geometry" />
        </mxCell>

        <!-- CARRIL 3: AWS IOT CORE Y PLANO DE CONTROL -->
        <mxCell id="lane-iot-core" value="3. AWS IoT Core (Broker mTLS y Control Plane)" style="swimlane;startSize=25;fillColor=#FFFFFF;strokeColor=#FF9900;strokeWidth=1.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="box-swimlanes">
          <mxGeometry x="875" y="45" width="390" height="925" as="geometry" />
        </mxCell>

        <mxCell id="step-4-broker" value="Paso 4: Aplicación Inmediata de la Revocación&#xa;&#xa;Acciones Inmediatas del Motor de AWS IoT:&#xa;1. Cambio de estado a INACTIVE en el Device Registry.&#xa;2. Terminación forzada de la conexión MQTT si estaba activa.&#xa;3. Invalidación de la sesión TLS en memoria del broker.&#xa;4. Supresión inmediata de la evaluación de políticas.&#xa;5. Generación de evento CertificateStateChanged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF9900;strokeWidth=2;fontSize=12;align=left;spacingLeft=12;fontColor=#232F3E;" vertex="1" parent="lane-iot-core">
          <mxGeometry x="20" y="240" width="350" height="180" as="geometry" />
        </mxCell>

        <mxCell id="step-5-broker" value="Mecanismo de Detección y Rechazo mTLS:&#xa;&#xa;- Al recibir un Client Hello del hardware revocado:&#xa;  1. Broker solicita el certificado cliente X.509.&#xa;  2. Consulta la base de certificados activos.&#xa;  3. Detecta estado INACTIVE o no registrado.&#xa;  4. Envía alerta TLS fatal al cliente y cierra socket.&#xa;  5. Incrementa métrica Connect.AuthError en CloudWatch.&#xa;  6. Bloquea todo intento de publicación o suscripción." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF9900;strokeWidth=2;fontSize=12;align=left;spacingLeft=12;fontColor=#232F3E;" vertex="1" parent="lane-iot-core">
          <mxGeometry x="20" y="450" width="350" height="205" as="geometry" />
        </mxCell>

        <!-- CARRIL 4: AUDITORIA INMUTABLE Y SEGURIDAD -->
        <mxCell id="lane-audit" value="4. Auditoría y Cumplimiento (Cuenta Security us-east-1)" style="swimlane;startSize=25;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="box-swimlanes">
          <mxGeometry x="1305" y="45" width="370" height="925" as="geometry" />
        </mxCell>

        <mxCell id="step-audit-1" value="Registro Forense Inmutable en CloudTrail:&#xa;&#xa;Eventos de Gestión Capturados Automáticamente:&#xa;- EventName: UpdateCertificate&#xa;- EventName: DetachPolicy&#xa;- EventName: DetachThingPrincipal&#xa;&#xa;Metadatos Guardados Obligatoriamente:&#xa;* Identidad del operador (userIdentity con MFA).&#xa;* Dirección IP de origen y marca de tiempo ISO 8601.&#xa;* ARN del certificado revocado y FincaID afectado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#545B64;strokeWidth=2;fontSize=12;align=left;spacingLeft=12;fontColor=#232F3E;" vertex="1" parent="lane-audit">
          <mxGeometry x="20" y="240" width="330" height="210" as="geometry" />
        </mxCell>

        <mxCell id="step-audit-2" value="Retención WORM a 5 Años (Ley 1581 y FNC):&#xa;&#xa;1. Almacenamiento en S3 Cuenta Security:&#xa;   Bucket: aromapacifico-audit-trail-security&#xa;   Configuración: S3 Object Lock en Compliance Mode.&#xa;   Retención mínima: 1.825 días (5 años).&#xa;2. Prohibición de Modificación o Borrado:&#xa;   Protegido por SCP desde la raíz de Organizations.&#xa;   Ningún rol de producción puede alterar el registro.&#xa;3. Trazabilidad Legal para Reclamaciones FNC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#545B64;strokeWidth=2;fontSize=12;align=left;spacingLeft=12;fontColor=#232F3E;" vertex="1" parent="lane-audit">
          <mxGeometry x="20" y="480" width="330" height="225" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>