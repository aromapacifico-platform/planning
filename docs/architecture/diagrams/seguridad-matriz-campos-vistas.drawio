        <!-- PANEL DE RESUMEN INFERIOR -->
        <mxCell id="box-audit-summary" value="POLÍTICA DE RETENCIÓN Y AUDITORÍA INMUTABLE:&#xa;1. Retención Legal Obligatoria: 5 años (1.825 días) inmutables en DynamoDB y S3 Object Lock en cuenta Security.&#xa;2. Anonimización por Separación Física: La tabla sacos_publicos jamás aloja columnas de PII; el modelo previene fugas por errores de serialización.&#xa;3. Respaldo y RPO: Eventos de saco cuentan con RPO de 15 minutos mediante réplica cruzada hacia us-east-2 (Ohio)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#545B64;strokeWidth=2;fontSize=12;align=left;spacingLeft=15;fontColor=#232F3E;" vertex="1" parent="box-matrix">
