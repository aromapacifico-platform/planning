<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" compressed="false">
  <diagram id="matriz-campos-vistas" name="Matriz de Campos y Vistas Segregadas del Saco">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITULO PRINCIPAL -->
        <mxCell id="title" value="AromaPacífico - Matriz de Segregación de Campos del Saco y Vistas por Perfil" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="300" y="30" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Protección de Datos Personales (Ley 1581 de 2012): Segregación de Atributos entre Comprador, Centro de Acopio y Caficultor" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#5A6B7C;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="1200" height="25" as="geometry" />
        </mxCell>

        <!-- PANEL IZQUIERDO: ESPECIFICACION DE TOKENIZACION DEL CODIGO -->
        <mxCell id="sec-token" value="ESTRUCTURA Y TOKENIZACIÓN DEL CÓDIGO DE SACO (60 KG)&#xa;Algoritmo Criptográfico Unidireccional sin Exposición de Cédula ni Finca&#xa;&#xa;Formato Canónico Oficial:&#xa;SACO-[AÑO]-[DEPTO]-[HASH8]  -->  Ejemplo: SACO-2026-CAU-7F3A9C12&#xa;&#xa;Fórmula Criptográfica:&#xa;Digest = HMAC-SHA-256( Salt_KMS, FincaID || LoteID || Timestamp || Nonce )&#xa;Hash8  = Substring( Hex(Digest), 0, 8 )&#xa;&#xa;Propiedades de Seguridad:&#xa;1. Irreversibilidad Matemática: Es imposible deducir la cédula o coordenadas a partir del hash.&#xa;2. Resistencia a Colisiones: 2^32 combinaciones únicas por departamento y año (> 4.290 millones).&#xa;3. No-Correlación Pública: Dos sacos de la misma finca poseen identificadores completamente disjuntos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#1D76DB;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=15;spacingTop=12;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="115" width="820" height="235" as="geometry" />
        </mxCell>

        <!-- PANEL DERECHO: PRINCIPIO DE ACCESO SEGMENTADO -->
        <mxCell id="sec-segregation" value="PRINCIPIOS DE ACCESO SEGMENTADO (Privacy by Design)&#xa;Garantía Legal de Privacidad bajo la Ley Estatutaria 1581 de 2012&#xa;&#xa;1. Vista del Comprador Internacional (Web Pública):&#xa;   - Acceso exclusivo a calidad agronómica: variedad, humedad de secado, procedencia regional.&#xa;   - Bloqueo categórico de PII: ni cédula, ni nombre, ni coordenadas GPS, ni rutas de transporte.&#xa;&#xa;2. Vista del Centro de Acopio (LAN Operativa con MFA):&#xa;   - Acceso operativo a pesaje, estado del saco, viaje asignado e historial de secado del lote.&#xa;   - Cédula de caficultor enmascarada (solo últimos 4 dígitos visibles para verificación documental).&#xa;&#xa;3. Vista del Caficultor (App Móvil en Finca):&#xa;   - Visualización íntegra de sus propias fincas, lotes, sacos creados y alertas fitosanitarias.&#xa;   - Aislamiento absoluto: denegación estricta de acceso a fincas de otros productores." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#0E8A16;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=15;spacingTop=12;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="900" y="115" width="850" height="235" as="geometry" />
        </mxCell>

        <!-- CONTENEDOR PRINCIPAL: MATRIZ DE CAMPOS VS PERFILES -->
        <mxCell id="box-matrix" value="MATRIZ DETALLADA DE CAMPOS DEL EXPEDIENTE DEL SACO VS PERFILES AUTORIZADOS" style="swimlane;startSize=30;horizontal=1;fillColor=#EAEDED;strokeColor=#545B64;strokeWidth=2;rounded=1;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="375" width="1700" height="865" as="geometry" />
        </mxCell>

        <!-- ENCABEZADOS DE LA MATRIZ -->
        <mxCell id="th-campo" value="Atributo / Campo de Datos" style="rounded=0;fillColor=#232F3E;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="box-matrix">
          <mxGeometry x="20" y="45" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="th-tipo" value="Clasificación Legal" style="rounded=0;fillColor=#232F3E;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="box-matrix">
          <mxGeometry x="310" y="45" width="200" height="30" as="geometry" />
