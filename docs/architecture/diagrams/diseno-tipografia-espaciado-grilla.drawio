        <mxCell id="v-metric-box" value="CARGA TOTAL DEL CAMIÓN (METRICA PRIMARIA)&#xa;&#xa;45 SACOS DE 60 KG (2.700 KG NETO)&#xa;Font: 32px Heavy | Legible a 80 cm en cabina" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#135E34;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#0D4A27;align=center;" vertex="1" parent="card-vehicular-ui">
          <mxGeometry x="25" y="100" width="770" height="85" as="geometry" />
