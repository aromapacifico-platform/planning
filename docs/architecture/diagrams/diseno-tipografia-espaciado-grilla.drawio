        <mxCell id="gr-phone" value="GRILLA TELÉFONO / VEHÍCULO:&#xa;• Columnas: 4 columnas fluidas&#xa;• Canaleta (Gutter): 16px&#xa;• Margen Exterior: 16px (20px en cabina para fundas rugerizadas)&#xa;• Comportamiento: Tarjetas en ancho completo (4 cols) para lectura clara" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#135E34;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="card-grids">
