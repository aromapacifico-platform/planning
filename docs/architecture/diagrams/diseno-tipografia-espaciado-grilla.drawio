        <mxCell id="web-body" value="Cuerpo Web Estándar: 16px (1.000rem) / Line-height: 24px / Regular (400)&#xa;Uso: Párrafos de lectura continua, notas de cata y descripción de procesos de beneficio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontSize=13;align=left;spacingLeft=15;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="card-web-scale">
