<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" compressed="false">
  <diagram id="diseno-tipografia-espaciado-grilla" name="Sistema de Diseno Tipografia Grilla y Espaciado">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ENCABEZADO Y TITULOS DEL DIAGRAMA -->
        <mxCell id="main-title" value="AromaPacífico - Sistema de Diseño: Tipografía, Grilla, Espaciado y Radios de Borde" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="main-subtitle" value="Especificación Dual: Ergonomía Vehicular en Cabina (50-80 cm / Vibración / Sol) vs. Consulta Web del Comprador (FNC 2026)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="100" y="60" width="1600" height="25" as="geometry" />
        </mxCell>

        <!-- SECCION 1: ESCALAS TIPOGRAFICAS DUALES -->
        <mxCell id="box-typography" value="1. ESCALAS TIPOGRÁFICAS DUALES: TELÉFONO EN CABINA (VEHICULAR) VS. CONSULTA WEB (ESCRITORIO)" style="swimlane;startSize=30;horizontal=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;rounded=1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1720" height="420" as="geometry" />
        </mxCell>

        <!-- CONTEXTO A: VEHICULAR / MOVIL -->
        <mxCell id="card-phone-scale" value="CONTEXTO 1: TELÉFONO EN VEHÍCULO / CAMPO (TRANSPORTADOR RURAL)&#xa;Parámetros: Montura a 50-80 cm (promedio 65 cm), vibración mecánica (4-16 Hz), sol directo (5.000-15.000 lux en cabina)" style="swimlane;startSize=35;fillColor=#FFFFFF;strokeColor=#135E34;strokeWidth=1.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#135E34;" vertex="1" parent="box-typography">
          <mxGeometry x="25" y="45" width="820" height="355" as="geometry" />
        </mxCell>

        <mxCell id="phone-display" value="Display Alerta: 40px (2.500rem) / Line-height: 48px / Heavy (800)&#xa;Uso: Avisos de detención o confirmación de entrega exitosa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#135E34;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=15;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="card-phone-scale">
          <mxGeometry x="15" y="45" width="790" height="38" as="geometry" />
        </mxCell>
        <mxCell id="phone-metric" value="Métrica de Impacto: 32px (2.000rem) / Line-height: 38px / Heavy (800)&#xa;Uso: Número de sacos (ej. 45 SACOS) y peso bruto en báscula (2.700 KG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontSize=13;align=left;spacingLeft=15;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="card-phone-scale">
          <mxGeometry x="15" y="90" width="790" height="38" as="geometry" />
        </mxCell>
        <mxCell id="phone-title" value="Título de Tarjeta: 24px (1.500rem) / Line-height: 32px / Bold (700)&#xa;Uso: Destino de viaje, cabecera de lote y código de saco legible a distancia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontSize=13;align=left;spacingLeft=15;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="card-phone-scale">
          <mxGeometry x="15" y="135" width="790" height="38" as="geometry" />
        </mxCell>
        <mxCell id="phone-subtitle" value="Subtítulo y Etiquetas: 20px (1.250rem) / Line-height: 28px / SemiBold (600)&#xa;Uso: Indicador de centro de acopio (Cauca, Huila, Tolima) y placas del vehículo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontSize=13;align=left;spacingLeft=15;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="card-phone-scale">
          <mxGeometry x="15" y="180" width="790" height="38" as="geometry" />
        </mxCell>
        <mxCell id="phone-body" value="Cuerpo Vehicular Base: 18px (1.125rem) / Line-height: 26px / Regular (400) o SemiBold (600)&#xa;Uso: Texto continuo de instrucciones de ruta e información de precinto de seguridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontSize=13;align=left;spacingLeft=15;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="card-phone-scale">
          <mxGeometry x="15" y="225" width="790" height="38" as="geometry" />
        </mxCell>
        <mxCell id="phone-button" value="Botón de Acción en Cabina: 18px (1.125rem) / Bold (700) / Altura táctil: 56px obligatoria&#xa;Uso: 'REGISTRAR ENTREGA' y 'CONFIRMAR CARGA' (mínimo 56x56 px para absorber vibración)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#135E34;strokeWidth=1.5;fontSize=13;align=left;spacingLeft=15;fontColor=#135E34;fontStyle=1;" vertex="1" parent="card-phone-scale">
          <mxGeometry x="15" y="270" width="790" height="38" as="geometry" />
        </mxCell>
        <mxCell id="phone-caption" value="Mínimo Legal en Cabina: 14px (0.875rem) / Line-height: 20px / SemiBold (600)&#xa;Regla de Oro: Prohibido texto inferior a 14px en cabina. Usado para marcas de tiempo UTC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;fontColor=#7F1D1D;fontStyle=1;" vertex="1" parent="card-phone-scale">
          <mxGeometry x="15" y="312" width="790" height="35" as="geometry" />
        </mxCell>

