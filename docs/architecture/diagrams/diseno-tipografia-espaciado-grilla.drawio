        <mxCell id="v-code-box" value="LOTE ACTIVO A ENTREGAR: SACO-2026-CAU-9F2B81&#xa;Token criptográfico HMAC-SHA-256 anonimizado (Font: 24px Bold Fira Code)&#xa;Soberanía Ley 1581: Cero cédula ni coordenadas de finca en pantalla" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#0F172A;align=center;" vertex="1" parent="card-vehicular-ui">
