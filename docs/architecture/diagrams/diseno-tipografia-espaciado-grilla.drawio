        <mxCell id="gr-web" value="GRILLA WEB COMPRADOR (ESCRITORIO):&#xa;• Columnas: 12 columnas modulares&#xa;• Canaleta (Gutter): 24px&#xa;• Ancho Máximo Contenedor: 1280px con centrado automático&#xa;• Comportamiento: Distribución 4-4-4 para métricas o 8-4 para reporte y mapa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#0F4C81;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=15;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="card-grids">
