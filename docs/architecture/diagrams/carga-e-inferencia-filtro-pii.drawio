<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" compressed="false">
  <diagram id="arbol-decision-pii" name="Flujo de Decisión Anti-PII y Tratamiento Ético">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1080" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITULO Y SUBTITULO -->
        <mxCell id="title" value="AromaPacífico - Diagrama de Flujo y Árbol de Decisión del Filtro de Privacidad Anti-PII" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="275" y="20" width="1100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Tratamiento de Imágenes con Personas de Punta a Punta: Detección, Bloqueo Fitosanitario, Custodia KMS y Retención WORM (Ley 1581)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#5A6B7C;" vertex="1" parent="1">
          <mxGeometry x="275" y="55" width="1100" height="25" as="geometry" />
        </mxCell>

        <!-- 1. INGESTA EN S3 RAW-IMAGES -->
        <mxCell id="box-s3-raw" value="Ingesta en S3: raw-images/focos/{FincaID}/{LoteID}/&#xa;&#xa;• Carga de imagen aérea desde dron con URL prefirmada HTTPS&#xa;• Cifrado SSE-KMS obligatorio | Dispara evento s3:ObjectCreated:Put" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;fontColor=#232F3E;align=center;" vertex="1" parent="1">
          <mxGeometry x="575" y="95" width="500" height="75" as="geometry" />
        </mxCell>

        <!-- 2. LAMBDA: PRIVACYFILTERFUNCTION -->
        <mxCell id="box-lambda-filter" value="Lambda: PrivacyFilterFunction (Graviton2 arm64, 512 MB) · us-east-1&#xa;&#xa;• Lee imagen en streaming RAM efímera (cero persistencia en disco)&#xa;• Coordina la inspección perimetral previa antes de cualquier inferencia agronómica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF9900;strokeWidth=2;fontSize=12;fontColor=#232F3E;align=center;" vertex="1" parent="1">
          <mxGeometry x="575" y="200" width="500" height="75" as="geometry" />
        </mxCell>

        <!-- 3. INVOCACION REKOGNITION -->
        <mxCell id="box-rekog-call" value="Amazon Rekognition: DetectFaces &amp; DetectLabels&#xa;&#xa;• Invocación paralela en us-east-1 (Latencia &lt; 200 ms)&#xa;• Categorías humanas: Person, Human, Face, Worker, Farmer&#xa;• Umbral mínimo de confianza perimetral: MinConfidence = 50.0%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="200" width="470" height="75" as="geometry" />
        </mxCell>

        <!-- 4. ROMBO DE DECISION -->
        <mxCell id="dec-human" value="¿Figura humana&#xa;detectada?&#xa;(Confianza &gt; 50%)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=#545B64;strokeWidth=2;fontSize=13;fontColor=#232F3E;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="675" y="315" width="300" height="95" as="geometry" />
        </mxCell>

        <!-- ==================== CONTENEDOR RAMA SI (8 PASOS) ==================== -->
        <mxCell id="zone-si-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#D93F0B;strokeWidth=2;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="765" height="585" as="geometry" />
        </mxCell>
        <mxCell id="zone-si-header" value="RAMA SÍ: DETECCIÓN POSITIVA DE PERSONA · PROTOCOLO DE AISLAMIENTO ÉTICO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#D93F0B;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#232F3E;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="765" height="35" as="geometry" />
        </mxCell>

        <!-- PASO SI 1 -->
        <mxCell id="step-si-1" value="1. Aborta Inferencia Fitosanitaria&#xa;• Cero llamadas a modelos foliares de roya o broca ($0 USD gastado en inferencia botánica)&#xa;• Previene de forma determinista la fuga de información personal hacia algoritmos comerciales" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93F0B;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="725" height="55" as="geometry" />
        </mxCell>

        <!-- PASO SI 2 -->
        <mxCell id="step-si-2" value="2. Etiqueta Sensitivity = RESTRICTED_PII&#xa;• S3 Object Tagging obligatorio y atributo en DynamoDB: Sensitivity = RESTRICTED_PII&#xa;• Marca el expediente fitosanitario con estado de bloqueo legal: PII_DETECTED_BLOQUEADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93F0B;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="555" width="725" height="55" as="geometry" />
        </mxCell>

        <!-- PASO SI 3 -->
        <mxCell id="step-si-3" value="3. Traslada a s3://aromapacifico-quarantine-pii/ (Security)&#xa;• Transferencia segura y atómica hacia el bucket aislado radicado en la cuenta AromaPacifico-Security&#xa;• Validación de integridad mediante verificación de hash criptográfico SHA-256 de origen a destino" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93F0B;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="725" height="55" as="geometry" />
        </mxCell>

        <!-- PASO SI 4 -->
        <mxCell id="step-si-4" value="4. Purgado del Bucket Productivo&#xa;• Eliminación atómica e inmediata del objeto original en s3://aromapacifico-objetos-prod/raw-images/&#xa;• Garantiza que ninguna imagen con personas permanezca en los repositorios de producción o desarrollo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93F0B;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="685" width="725" height="55" as="geometry" />
        </mxCell>

        <!-- PASO SI 5 -->
        <mxCell id="step-si-5" value="5. Cifrado Restringido con KMS CMK Oficial de Datos&#xa;• Cifrado en reposo con llave KMS CMK exclusiva de seguridad (alias/aromapacifico-quarantine-cmk)&#xa;• Política IAM Zero Trust: Acceso exclusivo para el Oficial de Datos (DataPrivacyOfficerRole)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93F0B;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="750" width="725" height="55" as="geometry" />
        </mxCell>

        <!-- PASO SI 6 -->
        <mxCell id="step-si-6" value="6. S3 Object Lock en Compliance a 5 Años&#xa;• Retención inmutable WORM por 1.825 días (5 años calendarios exactos) según exige la Ley 1581 / SIC&#xa;• Ninguna identidad de AWS (ni la cuenta Root de la organización) puede borrar ni acortar la retención" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93F0B;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="815" width="725" height="55" as="geometry" />
        </mxCell>

        <!-- PASO SI 7 -->
        <mxCell id="step-si-7" value="7. Notificación SNS de Alerta al Oficial de Privacidad&#xa;• Despacho de alerta crítica por Amazon SNS y registro inmutable en AWS CloudTrail / CloudWatch Logs&#xa;• Generación de expediente forense digital para soporte probatorio ante requerimientos de la SIC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93F0B;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="725" height="55" as="geometry" />
        </mxCell>

        <!-- PASO SI 8 -->
        <mxCell id="step-si-8" value="8. Difuminado/Anonimización Opcional para Cultivo&#xa;• Si el agrónomo certifica necesidad técnica: Función aplica box blur irreversible sobre la persona&#xa;• La copia anonimizada (foto_anonimizada.jpg) reingresa al diagnóstico sin exponer la identidad del titular" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D93F0B;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="945" width="725" height="65" as="geometry" />
        </mxCell>

        <!-- ==================== CONTENEDOR RAMA NO (3 PASOS) ==================== -->
        <mxCell id="zone-no-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF5;strokeColor=#0E8A16;strokeWidth=2;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="845" y="445" width="765" height="585" as="geometry" />
        </mxCell>
        <mxCell id="zone-no-header" value="RAMA NO: FOTO LIMPIA · AVANCE NOMINAL AL PIPELINE FITOSANITARIO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#0E8A16;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#232F3E;align=center;" vertex="1" parent="1">
          <mxGeometry x="845" y="445" width="765" height="35" as="geometry" />
        </mxCell>

        <!-- PASO NO 1 -->
        <mxCell id="step-no-1" value="1. Imagen Aprobada como Solo Cultivo&#xa;&#xa;• Validación técnica: La toma contiene exclusivamente dosel de cafeto, hojas o suelo productivo&#xa;• Confirma de manera certificada la ausencia de figuras humanas, rostros o transeúntes&#xa;• Habilita la derivación segura y lícita hacia los modelos fitosanitarios de la plataforma AromaPacífico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8A16;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="865" y="495" width="725" height="110" as="geometry" />
        </mxCell>

        <!-- PASO NO 2 -->
        <mxCell id="step-no-2" value="2. Avance a Inferencia Fitosanitaria Custom Labels&#xa;&#xa;• Invocación administrada a Amazon Rekognition Custom Labels en us-east-1 (Costo: $0.0010 USD / llamada)&#xa;• Diagnóstico foliar automatizado: Detección de Roya (Hemileia vastatrix) y Broca (Hypothenemus hampei)&#xa;• Vector de diagnóstico: Etiqueta fitosanitaria, coordenadas de delimitación y nivel de confianza (%)&#xa;• Latencia de ejecución &lt; 400 ms | Zero cómputo ocioso en espera ($0 USD en reposo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8A16;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="865" y="630" width="725" height="130" as="geometry" />
        </mxCell>

        <!-- PASO NO 3 -->
        <mxCell id="step-no-3" value="3. Escritura Idempotente en Expediente DynamoDB&#xa;&#xa;• Inserción atómica en tabla ExpedienteFitosanitario con ConditionExpression (garantía anti-duplicados)&#xa;• Atributos registrados: TimestampUTC, DiagnosticLabel, ConfidenceScore (ej. 92.4%), SourceObjectID&#xa;• Estado del foco: FOCO_CONFIRMADO (o FOCO_DESCARTADO si la confianza fitosanitaria es &lt; 80%)&#xa;• Notificación al agrónomo colegiado de la FNC vía Amazon SNS con el reporte técnico adjunto&#xa;&#xa;INVARIANTE ZERO TRUST: NINGUNA FUNCIÓN SERVERLESS AUTORIZA FUMIGACIÓN&#xa;La plataforma asiste el diagnóstico; la autorización de aspersión exige firma humana con MFA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8A16;strokeWidth=1.5;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="865" y="785" width="725" height="225" as="geometry" />
        </mxCell>

        <!-- ==================== CONECTORES ORTOGONALES CALCULADOS ==================== -->
        <!-- S3 Ingesta a Lambda Filter -->
        <mxCell id="c-s3-filter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D76DB;strokeWidth=2.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-s3-raw" target="box-lambda-filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda Filter a Rekognition Call -->
        <mxCell id="c-filter-rekog" value="Invoca Rekognition" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D76DB;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;fontColor=#1D76DB;fontStyle=1;" edge="1" parent="1" source="box-lambda-filter" target="box-rekog-call">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda Filter a Rombo Decision -->
        <mxCell id="c-filter-dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-lambda-filter" target="dec-human">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rombo a Rama SI (Izquierda) -->
        <mxCell id="c-dec-si" value="SÍ (Figura humana detectada &gt; 50%)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D93F0B;strokeWidth=2.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#D93F0B;fontStyle=1;" edge="1" parent="1" source="dec-human" target="zone-si-header">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="422" y="363" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Rombo a Rama NO (Derecha) -->
        <mxCell id="c-dec-no" value="NO (Solo cultivo)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0E8A16;strokeWidth=2.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#0E8A16;fontStyle=1;" edge="1" parent="1" source="dec-human" target="zone-no-header">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1228" y="363" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>