<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" compressed="false">
  <diagram id="flujo-drones" name="Flujo de los 5 Servicios de Drones">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITULO -->
        <mxCell id="title" value="AromaPacífico - Arquitectura de Flujo Operativo de los 5 Servicios de Drones" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Transición de Estados, Modo Combinado (Áreas y Precisión), Compuerta Humana Mandatoria y Cierre de Expediente" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#5A6B7C;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="900" height="25" as="geometry" />
        </mxCell>

        <!-- SERVICIO 1: DELIMITAR LOTE -->
        <mxCell id="srv1" value="SERVICIO 1: Delimitar Lote&#xa;(Modo Agricultura de Áreas)&#xa;&#xa;- Vuelo inicial ortomosaico de la finca.&#xa;- Genera geometría poligonal GeoJSON.&#xa;- Identifica y persiste Zonas No-Fly:&#xa;  * Casas y beneficiaderos&#xa;  * Fuentes hídricas y vías públicas.&#xa;- Condición bloqueante de plataforma:&#xa;  Sin polígono NO se autoriza fumigación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#1D76DB;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="310" height="190" as="geometry" />
        </mxCell>

        <!-- COMPUERTA BLOQUEANTE DELIMITACIÓN -->
        <mxCell id="gate-delim" value="Validación de Delimitación&#xa;¿Existe Polígono y No-Fly Zones?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=#545B64;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="420" y="155" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- EVENTO DISPARADOR SENSOR -->
        <mxCell id="trig-sensor" value="Disparador IoT de Campo&#xa;Sensor de Suelo / Clima&#xa;&#xa;Lectura anómala fuera de umbral&#xa;(pH, humedad suelo, temp o NPK).&#xa;Genera coordenada GPS del foco." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#D93F0B;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="310" height="120" as="geometry" />
        </mxCell>

        <!-- SERVICIO 2: CONFIRMAR ALERTA -->
        <mxCell id="srv2" value="SERVICIO 2: Confirmar Alerta&#xa;(Modo Agricultura de Precisión)&#xa;&#xa;- Vuelo táctico directo al foco del sensor.&#xa;- No recorre toda la finca (ahorro batería).&#xa;- Captura fotográfica de alta resolución.&#xa;- Descarga local o enlace celular.&#xa;- Inferencia IA: S3 -> Lambda -> Rekognition.&#xa;- Persiste probabilidad de plaga en expediente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#1D76DB;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="420" y="360" width="310" height="160" as="geometry" />
        </mxCell>

        <!-- COMPUERTA HUMANA OBLIGATORIA (ZERO TRUST) -->
        <mxCell id="gate-human" value="COMPUERTA HUMANA MANDATORIA&#xa;Agrónomo Registrado Federación&#xa;&#xa;Evaluación técnica de evidencia IA:&#xa;- Ningún trigger de IA autoriza aspersiones.&#xa;- Firma digital con MFA obligatorio.&#xa;- Asigna Finca, Lote, Ventana horaria,&#xa;  Lote de agroquímico ICA y Operador UAS." style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF9900;strokeWidth=3;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="340" width="300" height="200" as="geometry" />
        </mxCell>

        <!-- RECHAZO / FALSA ALARMA -->
        <mxCell id="case-dismiss" value="Caso Desestimado / Falsa Alarma&#xa;Expediente archivado en DynamoDB&#xa;con trazabilidad completa de 5 años." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=#545B64;strokeWidth=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="830" y="180" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- SERVICIO 3: FUMIGACION -->
        <mxCell id="srv3" value="SERVICIO 3: Fumigación de Precisión&#xa;(Modo Agricultura de Precisión)&#xa;&#xa;- Dron aspersor con carga útil de agroquímico.&#xa;- Misión precargada offline en cabecera/acopio.&#xa;- Aspersión focalizada únicamente en el lote.&#xa;- Exclusión estricta de zonas No-Fly.&#xa;- Almacena bitácora de vuelo en buffer interno.&#xa;- Estado: 'En Fumigación / Pendiente Cierre'." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#0E8A16;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1170" y="360" width="310" height="160" as="geometry" />
        </mxCell>

        <!-- SERVICIO 4: VERIFICAR POST-FUMIGACIÓN -->
        <mxCell id="srv4" value="SERVICIO 4: Verificar Post-Fumigar&#xa;(Modo Agricultura de Precisión)&#xa;&#xa;- Vuelo táctico a los 7-10 días del tratamiento.&#xa;- Captura fotografía o video corto del foco.&#xa;- Inferencia IA confirma recuperación foliar.&#xa;- Si el archivo no llega: caso sigue ABIERTO.&#xa;- Sube bitácora de vuelo final al acopio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#1D76DB;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1170" y="580" width="310" height="160" as="geometry" />
        </mxCell>

        <!-- CIERRE DEL EXPEDIENTE -->
        <mxCell id="case-closed" value="CIERRE FORMAL DEL EXPEDIENTE&#xa;Estado: CERRADO&#xa;&#xa;- Evidencia fotográfica y de vuelo persistida.&#xa;- Auditoría completa registrada en CloudTrail/S3.&#xa;- Registro de retención asegurado por 5 años." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#0E8A16;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;fontColor=#0E8A16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="615" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- SERVICIO 5: ESTIMAR COSECHA -->
        <mxCell id="srv5" value="SERVICIO 5: Estimar Cosecha&#xa;(Modo Agricultura de Áreas - Independiente de Plagas)&#xa;&#xa;- Vuelo de área fotogramétrico ejecutado 1 vez por ciclo de cosecha.&#xa;- Conteo volumétrico y densidad de grano en cafetales.&#xa;- Inferencia IA: calcula proyección de sacos de 60 kg esperados.&#xa;- Notificación logística anticipada al Centro de Acopio departamental.&#xa;- Prohibición estricta: Este servicio NO transporta ni aplica agroquímicos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#5319E7;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="670" height="160" as="geometry" />
        </mxCell>

        <!-- CONECTORES -->
        <!-- Srv1 a Gate Delim -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="srv1" target="gate-delim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gate Delim a Srv2 (Requisito cumplido) -->
        <mxCell id="e2" value="Polígono Activo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0E8A16;strokeWidth=2;fontSize=12;fontColor=#0E8A16;" edge="1" parent="1" source="gate-delim" target="srv2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Sensor a Srv2 -->
        <mxCell id="e3" value="Alerta Foco GPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D93F0B;strokeWidth=2;fontSize=12;fontColor=#D93F0B;" edge="1" parent="1" source="trig-sensor" target="srv2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Srv2 a Gate Humana -->
        <mxCell id="e4" value="Evidencia IA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="srv2" target="gate-human">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gate Humana a Rechazo -->
        <mxCell id="e5" value="No Autorizada" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;dashed=1;fontSize=12;fontColor=#545B64;" edge="1" parent="1" source="gate-human" target="case-dismiss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gate Humana a Srv3 -->
        <mxCell id="e6" value="AUTORIZADA con Firma Digital" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0E8A16;strokeWidth=3;fontSize=12;fontColor=#0E8A16;fontStyle=1;" edge="1" parent="1" source="gate-human" target="srv3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Srv3 a Srv4 -->
        <mxCell id="e7" value="Fumigación Ejecutada&#xa;(7-10 días ventana)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="srv3" target="srv4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Srv4 a Cierre -->
        <mxCell id="e8" value="Foto Verificada + Bitácora Persistida" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0E8A16;strokeWidth=2;fontSize=12;fontColor=#0E8A16;" edge="1" parent="1" source="srv4" target="case-closed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- PIE DE NOTA -->
        <mxCell id="footer" value="Invariantes Clave: Ningún servicio sustituye a otro | Sin autorización humana no hay aspersión | Misiones offline en cabecera/acopio | Store-and-forward garantizado" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#5A6B7C;" vertex="1" parent="1">
          <mxGeometry x="350" y="780" width="900" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
