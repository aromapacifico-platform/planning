<mxfile host="drawio"><diagram id="vista" name="Vista general"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2140" pageHeight="1290" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="AromaPacífico · Arquitectura completa (AWS us-east-1)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cajas negras E6-xx: lo que codifica la Épica 6 (plan de 100 horas)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=16;fontStyle=1;strokeColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="760" height="50" as="geometry"/></mxCell><mxCell id="c3" value="1 · Campo (store-and-forward)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="400" height="1180" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Finca y beneficiadero&lt;/b&gt;&lt;br&gt;Nodo ESP32-S3 + LTE-M/NB-IoT&lt;br&gt;Sondas NPK, pH, suelo, aire, grano&lt;br&gt;Buffer flash ≤ 24 h · reintentos 1/5/15 min" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="360" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Finca sin cobertura&lt;/b&gt;&lt;br&gt;Mismo nodo + Iridium SBD (RockBLOCK 9603)&lt;br&gt;ACK de persistencia antes de borrar" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="360" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Dron y estación de cuadrilla&lt;/b&gt;&lt;br&gt;Misión precargada (token 48 h, polígono, no-fly)&lt;br&gt;Bitácora y fotos en memoria hasta sincronizar" sty