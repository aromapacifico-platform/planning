<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" compressed="false">
  <diagram id="inferencia-serverless" name="Inferencia Serverless y Privacidad">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITULO Y SUBTITULO -->
        <mxCell id="title" value="AromaPacífico - Inferencia Serverless y Protección de Privacidad (Ley 1581 de 2012)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="250" y="25" width="1100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Pipeline Serverless Desacoplado: Ingesta de Imágenes, Filtro Ético Anti-PII, Detección de Plagas y Expediente Fitosanitario" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#5A6B7C;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="1100" height="25" as="geometry" />
        </mxCell>

        <!-- 1. DRON / CUADRILLA UAS -->
        <mxCell id="box-dron" value="Dron / Cuadrilla UAS&#xa;Estación de Campo / Tableta&#xa;&#xa;• Captura fotográfica RGB / Multiespectral.&#xa;• Buffer local store-and-forward (hasta 24h).&#xa;• Drenado vía Wi-Fi seguro al acopio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#FF9900;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="230" height="150" as="geometry" />
        </mxCell>

        <!-- 2. AMAZON S3 RAW -->
        <mxCell id="box-s3" value="Amazon S3&#xa;Bucket: aromapacifico-raw-images&#xa;&#xa;• Carga de imagen fotográfica del foco.&#xa;• Cifrado en reposo SSE-KMS obligatorio.&#xa;• Dispara evento: s3:ObjectCreated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#D93F0B;strokeWidth=2;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="140" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- 3. AWS LAMBDA FILTRO -->
        <mxCell id="box-lambda" value="AWS Lambda&#xa;Función: ProcessDroneImage&#xa;&#xa;• Ejecución serverless Pay-As-You-Go.&#xa;• Extrae metadatos EXIF (GPS, fecha, dron).&#xa;• Orquesta validación ética de privacidad." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF9900;strokeWidth=2;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="140" width="250" height="150" as="geometry" />
        </mxCell>

        <!-- 4. REKOGNITION FILTRO PERSONAS -->
        <mxCell id="box-detect-faces" value="Amazon Rekognition&#xa;Filtro Ético Anti-PII (DetectFaces)&#xa;&#xa;• Escaneo de rostros y personas en la toma.&#xa;• Cumplimiento estricto Ley 1581 de 2012.&#xa;• Previene almacenamiento de datos sensibles." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="140" width="260" height="150" as="geometry" />
        </mxCell>

        <!-- 5. COMPUERTA ÉTICA -->
        <mxCell id="gate-pii" value="¿Persona Identificable&#xa;Detectada?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=#545B64;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1270" y="130" width="220" height="170" as="geometry" />
        </mxCell>

        <!-- 6. CUARENTENA PII (RAMA SÍ) -->
        <mxCell id="box-quarantine" value="Cuarentena de Privacidad&#xa;Bucket S3: aromapacifico-quarantine-pii&#xa;&#xa;• Acceso restringido exclusivo a Oficial de Seguridad.&#xa;• Imagen EXCLUIDA de inferencia agrícola.&#xa;• Registro de evento de auditoría en CloudTrail.&#xa;• Cero exposición en expedientes públicos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#D93F0B;strokeWidth=2;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1210" y="380" width="340" height="160" as="geometry" />
        </mxCell>

        <!-- 7. REKOGNITION CUSTOM LABELS (RAMA NO) -->
        <mxCell id="box-infer" value="Amazon Rekognition: Custom Labels&#xa;Modelo de Diagnóstico Fitosanitario&#xa;&#xa;• Clasificación de patologías foliares:&#xa;  - Roya del café (Hemileia vastatrix)&#xa;  - Broca del fruto (Hypothenemus hampei)&#xa;  - Mancha de hierro (Cercospora coffeicola)&#xa;• Reporta porcentaje de confianza y mapa de calor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF5;strokeColor=#0E8A16;strokeWidth=2;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="380" width="350" height="160" as="geometry" />
        </mxCell>

        <!-- 8. DYNAMODB EXPEDIENTE -->
        <mxCell id="box-dynamo" value="Amazon DynamoDB&#xa;Tabla: ExpedienteFitosanitario&#xa;&#xa;• Registro inmutable del foco fitosanitario.&#xa;• Atributos: FincaID, LoteID, Confianza, Fecha.&#xa;• Estado inicial: PENDIENTE_EVALUACION.&#xa;• Almacena URL segura de la imagen aprobada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="380" width="320" height="160" as="geometry" />
        </mxCell>

        <!-- 9. NOTIFICACIÓN Y COMPUERTA HUMANA -->
        <mxCell id="box-sns" value="Notificación al Agrónomo FNC&#xa;Amazon SNS + Panel de Gestión&#xa;&#xa;• Despacho de alerta agronómica con evidencia.&#xa;• PROHIBIDO autorizar fumigación por IA.&#xa;• Requiere firma humana con MFA para Servicio 3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF9900;strokeWidth=2;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=12;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="380" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- PANEL DE INVARIANTES Y DIRECTIVAS -->
        <mxCell id="panel-invariants" value="Directivas e Invariantes de Arquitectura Serverless y Privacidad:&#xa;1. Protección de Datos (Ley 1581 de 2012): Ninguna fotografía con personas identificables entra a la canalización de inferencia agrícola ni a registros públicos.&#xa;2. Cero Cómputo Ocioso FinOps: Arquitectura 100% serverless Pay-As-You-Go. Costo mensual en AWS Rekognition menor a $2,00 USD en cosecha pico.&#xa;3. Trazabilidad Inmutable: Registros y expedientes archivados con retención WORM de 5 años en Amazon S3 Object Lock y DynamoDB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#232F3E;strokeWidth=1;fontSize=12;align=left;spacingLeft=15;spacingTop=10;fontColor=#232F3E;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="580" width="1500" height="90" as="geometry" />
        </mxCell>

        <!-- CONECTORES Y FLECHAS -->
        <mxCell id="edge-dron-s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="box-dron" target="box-s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge-s3-lambda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D93F0B;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="box-s3" target="box-lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge-lambda-detect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF9900;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="box-lambda" target="box-detect-faces">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge-detect-gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="box-detect-faces" target="gate-pii">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rama Sí a Cuarentena -->
        <mxCell id="edge-gate-quarantine" value="SÍ (Persona Detectada)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D93F0B;strokeWidth=2;fontColor=#D93F0B;fontSize=12;fontStyle=1;" edge="1" parent="1" source="gate-pii" target="box-quarantine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rama No a Custom Labels -->
        <mxCell id="edge-gate-infer" value="NO (Solo Cultivo)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0E8A16;strokeWidth=2;fontColor=#0E8A16;fontSize=12;fontStyle=1;" edge="1" parent="1" source="gate-pii" target="box-infer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1380" y="340" />
              <mxPoint x="955" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Custom Labels a DynamoDB -->
        <mxCell id="edge-infer-dynamo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0E8A16;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="box-infer" target="box-dynamo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DynamoDB a SNS -->
        <mxCell id="edge-dynamo-sns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D76DB;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="box-dynamo" target="box-sns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
