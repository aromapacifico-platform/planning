<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" compressed="false">
  <diagram id="diseno-logo-paleta-estados" name="Sistema de Diseno Logo Paleta y Estados">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ENCABEZADO Y TITULOS DEL DIAGRAMA -->
        <mxCell id="main-title" value="AromaPacífico - Sistema de Diseño Visual: Identidad, Paleta Cromática y Estados del Saco" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="main-subtitle" value="Especificación Técnica de UI/UX, Accesibilidad WCAG 2.1 Nivel AAA, Resistencia Solar en Campo y Doble Codificación Visual (FNC 2026)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="100" y="60" width="1600" height="25" as="geometry" />
        </mxCell>

        <!-- CONTENEDOR 1: IDENTIDAD DE MARCA (LOGO E ISOTIPO EN SUS 3 VERSIONES) -->
        <mxCell id="box-brand" value="1. IDENTIDAD DE MARCA: LOGOTIPO E ISOTIPO (TRES VARIANTES OFICIALES)" style="swimlane;startSize=30;horizontal=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;rounded=1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1720" height="340" as="geometry" />
        </mxCell>

        <!-- VARIANTE A: COLOR PRINCIPAL -->
        <mxCell id="brand-col-card" value="VARIANTE 1: COLOR PRINCIPAL (CANVAS CLARO)&#xa;Uso: Aplicaciones móviles, portal web de consulta y papelería institucional" style="swimlane;startSize=25;fillColor=#FFFFFF;strokeColor=#135E34;strokeWidth=1.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#135E34;" vertex="1" parent="box-brand">
          <mxGeometry x="25" y="45" width="530" height="275" as="geometry" />
        </mxCell>
        <mxCell id="brand-col-visual" value="[ ISOTIPO COLOR: Grano Andino + Ola Pacifico + Cereza Madura ]&#xa;&#xa;AromaPacífico&#xa;FEDERACIÓN NACIONAL DE CAFETEROS · FNC 2026&#xa;&#xa;Paleta activa: Verde Cordillera (#135E34), Azul Pacifico (#0F4C81), Cereza (#9E1B1B)&#xa;Fondo optimizado: Blanco Pergamino (#FAF8F5) o Blanco Puro (#FFFFFF)&#xa;Relación de Contraste Tipográfico: 17.85:1 sobre blanco (Pasa AAA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#135E34;strokeWidth=2;fontSize=12;align=center;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="brand-col-card">
          <mxGeometry x="15" y="35" width="500" height="225" as="geometry" />
        </mxCell>

        <!-- VARIANTE B: UNA TINTA (MONOCROMO) -->
        <mxCell id="brand-mono-card" value="VARIANTE 2: UNA TINTA (MONOCROMÁTICA - 100% NEGRO)&#xa;Uso: Impresoras térmicas de acopio, sellos de sacos de fique, guías de despacho y fax" style="swimlane;startSize=25;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="box-brand">
          <mxGeometry x="595" y="45" width="530" height="275" as="geometry" />
        </mxCell>
        <mxCell id="brand-mono-visual" value="[ ISOTIPO UNA TINTA: Alto Contraste Negro Puro ]&#xa;&#xa;AromaPacífico&#xa;FEDERACIÓN NACIONAL DE CAFETEROS · FNC 2026&#xa;&#xa;Tinta: Negro Solido 100% (#000000) sobre Blanco Puro (#FFFFFF)&#xa;Trazos calados: 4.5 pt de separacion minima para evitar sangrado de tinta termica&#xa;Relación de Contraste Tipográfico: 21.0:1 (Máximo Teórico WCAG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=12;align=center;fontColor=#000000;fontStyle=0;" vertex="1" parent="brand-mono-card">
          <mxGeometry x="15" y="35" width="500" height="225" as="geometry" />
        </mxCell>

        <!-- VARIANTE C: NEGATIVO (FONDO OSCURO) -->
        <mxCell id="brand-dark-card" value="VARIANTE 3: EN NEGATIVO (CANVAS OSCURO / MODO NOCHE)&#xa;Uso: Splash screens, turno nocturno de transporte y paneles en cabina de camion" style="swimlane;startSize=25;fillColor=#0F172A;strokeColor=#334155;strokeWidth=1.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="box-brand">
          <mxGeometry x="1165" y="45" width="530" height="275" as="geometry" />
        </mxCell>
        <mxCell id="brand-dark-visual" value="[ ISOTIPO NEGATIVO: Blanco Puro Calado ]&#xa;&#xa;AromaPacífico&#xa;FEDERACIÓN NACIONAL DE CAFETEROS · FNC 2026&#xa;&#xa;Fondo: Carbon Pizarra Profundo (#0F172A)&#xa;Elementos graficos y tipografia: Blanco Puro (#FFFFFF) con subtitulo en Slate (#94A3B8)&#xa;Relación de Contraste Tipográfico: 17.85:1 sobre fondo oscuro (Pasa AAA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#FFFFFF;strokeWidth=2;fontSize=12;align=center;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="brand-dark-card">
          <mxGeometry x="15" y="35" width="500" height="225" as="geometry" />
        </mxCell>


        <!-- CONTENEDOR 2: PALETA CROMATICA Y TOKENS (MEDICION WCAG AAA) -->
        <mxCell id="box-palette" value="2. PALETA CROMÁTICA OFICIAL Y MEDICIÓN DE CONTRASTE SOLAR EN CAMPO" style="swimlane;startSize=30;horizontal=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;rounded=1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1720" height="260" as="geometry" />
        </mxCell>

        <!-- PRIMARIO VERDE -->
        <mxCell id="pal-primary" value="VERDE CORDILLERA&#xa;Primario Institucional&#xa;&#xa;HEX: #135E34&#xa;RGB: (19, 94, 52)&#xa;Contraste: 7.84:1&#xa;Clasificación: WCAG AAA&#xa;Uso: Acciones clave y marca" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#135E34;strokeColor=#0D4A27;strokeWidth=2;fontSize=12;align=center;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="box-palette">
          <mxGeometry x="25" y="45" width="225" height="195" as="geometry" />
