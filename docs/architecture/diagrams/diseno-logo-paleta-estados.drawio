          <mxGeometry x="775" y="45" width="225" height="195" as="geometry" />
        </mxCell>

        <!-- NEUTRO CARBON -->
        <mxCell id="pal-carbon" value="CARBÓN PROFUNDO&#xa;Neutro de Texto Base&#xa;&#xa;HEX: #0F172A&#xa;RGB: (15, 23, 42)&#xa;Contraste: 17.85:1&#xa;Clasificación: WCAG AAA Máx&#xa;Uso: Lectura bajo sol cenital" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#000000;strokeWidth=2;fontSize=12;align=center;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="box-palette">
          <mxGeometry x="1025" y="45" width="225" height="195" as="geometry" />
        </mxCell>

        <!-- NEUTRO PERGAMINO -->
        <mxCell id="pal-parchment" value="BLANCO PERGAMINO&#xa;Lienzo Anti-Deslumbramiento&#xa;&#xa;HEX: #FAF8F5&#xa;RGB: (250, 248, 245)&#xa;Reflectancia: Suave&#xa;Clasificación: Confort Visual&#xa;Uso: Fondo general de pantalla" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#CBD5E1;strokeWidth=2;fontSize=12;align=center;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="box-palette">
          <mxGeometry x="1275" y="45" width="200" height="195" as="geometry" />
        </mxCell>

        <!-- RESISTENCIA SOLAR REGLA -->
        <mxCell id="pal-formula" value="REGLA SOLAR EN CAMPO&#xa;&#xa;Bajo 80.000 lux (sol ecuatorial), el contraste real cae un 50% por luz ambiental reflejada.&#xa;Una relación base de 7.5:1 a 10.0:1 garantiza una relación percibida mayor a 4.0:1 en pantalla." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;fontColor=#1E3A8A;fontStyle=0;" vertex="1" parent="box-palette">
          <mxGeometry x="1495" y="45" width="200" height="195" as="geometry" />
        </mxCell>


        <!-- CONTENEDOR 3: ESTADOS DEL SACO (DOBLE CODIFICACIÓN OBLIGATORIA) -->
        <mxCell id="box-states" value="3. ESTADOS DEL SACO DE CAFÉ (60 KG): DOBLE CODIFICACIÓN (COLOR + FORMA / ICONO + TEXTO VISIBLE)" style="swimlane;startSize=30;horizontal=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;rounded=1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1720" height="280" as="geometry" />
        </mxCell>

        <!-- ESTADO 1: EN PREPARACION -->
        <mxCell id="card-state-prep" value="ESTADO 1: EN PREPARACIÓN&#xa;Fase: Beneficiadero y Finca Cafetera" style="swimlane;startSize=25;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;rounded=1;fontSize=12;fontStyle=1;fontColor=#78350F;" vertex="1" parent="box-states">
          <mxGeometry x="25" y="45" width="390" height="215" as="geometry" />
        </mxCell>
        <mxCell id="badge-prep" value="[ ICONO: SACO CON ENGRANAJE ]&#xa;&#xa;EN PREPARACIÓN&#xa;&#xa;Tokens: Texto #78350F | Fondo #FEF3C7 | Borde #D97706&#xa;Contraste WCAG: 8.15:1 (Cumple AAA)&#xa;Silueta: Rombo o rectángulo redondeado&#xa;Significado: Secado, pesaje y marcado con hash HMAC-SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;fontColor=#78350F;fontStyle=0;" vertex="1" parent="card-state-prep">
          <mxGeometry x="15" y="35" width="360" height="165" as="geometry" />
        </mxCell>

        <!-- ESTADO 2: EN VIAJE -->
        <mxCell id="card-state-travel" value="ESTADO 2: EN VIAJE&#xa;Fase: Transporte Rural y Carretera" style="swimlane;startSize=25;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;rounded=1;fontSize=12;fontStyle=1;fontColor=#1E40AF;" vertex="1" parent="box-states">
          <mxGeometry x="450" y="45" width="390" height="215" as="geometry" />
        </mxCell>
        <mxCell id="badge-travel" value="[ ICONO: CAMIÓN DE CARGA / CHEVRON ]&#xa;&#xa;EN VIAJE&#xa;&#xa;Tokens: Texto #1E40AF | Fondo #DBEAFE | Borde #2563EB&#xa;Contraste WCAG: 7.15:1 (Cumple AAA)&#xa;Silueta: Flecha direccional derecha / cilindro&#xa;Significado: En custodia de transportador hacia acopio o puerto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;fontColor=#1E40AF;fontStyle=0;" vertex="1" parent="card-state-travel">
          <mxGeometry x="15" y="35" width="360" height="165" as="geometry" />
        </mxCell>

        <!-- ESTADO 3: ACEPTADO -->
        <mxCell id="card-state-acc" value="ESTADO 3: ACEPTADO&#xa;Fase: Acopio / Puerto de Buenaventura" style="swimlane;startSize=25;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;rounded=1;fontSize=12;fontStyle=1;fontColor=#14532D;" vertex="1" parent="box-states">
          <mxGeometry x="875" y="45" width="390" height="215" as="geometry" />
        </mxCell>
        <mxCell id="badge-acc" value="[ ICONO: ESCUDO CON CHECKMARK ]&#xa;&#xa;ACEPTADO&#xa;&#xa;Tokens: Texto #14532D | Fondo #DCFCE7 | Borde #16A34A&#xa;Contraste WCAG: 8.30:1 (Cumple AAA)&#xa;Silueta: Escudo perimetral continuo&#xa;Significado: Calidad SCA mayor a 80 puntos y humedad menor al 12%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;fontColor=#14532D;fontStyle=0;" vertex="1" parent="card-state-acc">
          <mxGeometry x="15" y="35" width="360" height="165" as="geometry" />
        </mxCell>

        <!-- ESTADO 4: RECHAZADO -->
        <mxCell id="card-state-rej" value="ESTADO 4: RECHAZADO&#xa;Fase: Acopio / Inspección Portuaria" style="swimlane;startSize=25;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;rounded=1;fontSize=12;fontStyle=1;fontColor=#7F1D1D;" vertex="1" parent="box-states">
          <mxGeometry x="1300" y="45" width="395" height="215" as="geometry" />
        </mxCell>
        <mxCell id="badge-rej" value="[ ICONO: OCTÁGONO CON ASPA X ]&#xa;&#xa;RECHAZADO&#xa;&#xa;Tokens: Texto #7F1D1D | Fondo #FEE2E2 | Borde #DC2626&#xa;Contraste WCAG: 8.20:1 (Cumple AAA)&#xa;Silueta: Octágono regular (detención)&#xa;Significado: Tacha, humedad mayor al 12.5% o defecto fitosanitario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;fontColor=#7F1D1D;fontStyle=0;" vertex="1" parent="card-state-rej">
          <mxGeometry x="15" y="35" width="365" height="165" as="geometry" />
        </mxCell>


        <!-- CONTENEDOR 4: ALERTA DE CULTIVO DE ALTO CONTRASTE Y GOBERNANZA -->
        <mxCell id="box-alert-gov" value="4. COMPONENTE DE ALERTA DE CULTIVO EN CAMPO Y ARQUITECTURA DE PRIVACIDAD (LEY 1581)" style="swimlane;startSize=30;horizontal=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;rounded=1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="1720" height="230" as="geometry" />
        </mxCell>

        <!-- TARJETA ALERTA CULTIVO -->
        <mxCell id="alert-card" value="ALERTA FITOSANITARIA DE CULTIVO (DETECCIÓN DE FOCO / UMBRAL FUERA DE RANGO)&#xa;Diseño Ergonómico para Lectura Inmediata bajo Sol Directo y Alerta Háptica en Teléfono" style="swimlane;startSize=25;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#7F1D1D;" vertex="1" parent="box-alert-gov">
          <mxGeometry x="25" y="45" width="850" height="170" as="geometry" />
        </mxCell>
        <mxCell id="alert-content" value="[ TRIÁNGULO DE ALERTA CON SIGNO DE EXCLAMACIÓN EN NEGRITA ]&#xa;&#xa;ALERTA CRÍTICA: ANOMALÍA EN LOTE 3 - FINCA EL ROSAL&#xa;Variable: Humedad suelo fuera de rango (32 % menor al umbral mínimo 40 %) | Lectura: 11:40 UTC&#xa;&#xa;Tokens: Texto #7F1D1D | Fondo #FEF2F2 | Borde 2.5px #B91C1C | Contraste: 9.16:1 (WCAG AAA)&#xa;Acción en Campo: Botón de llamada a agrónomo / Solicitud de dron de confirmación (Mínimo 48x48 px)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;fontColor=#7F1D1D;fontStyle=0;" vertex="1" parent="alert-card">
          <mxGeometry x="15" y="35" width="820" height="120" as="geometry" />
        </mxCell>

        <!-- PRIVACIDAD Y FINOPS -->
        <mxCell id="gov-card" value="GOBERNANZA DE DATOS (LEY 1581) Y SUSTENTACIÓN FINOPS&#xa;Segregación de Vistas y Optimización de Ancho de Banda Móvil en Zonas Rurales" style="swimlane;startSize=25;fillColor=#F0FDF4;strokeColor=#135E34;strokeWidth=1.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#135E34;" vertex="1" parent="box-alert-gov">
          <mxGeometry x="900" y="45" width="795" height="170" as="geometry" />
        </mxCell>
        <mxCell id="gov-content" value="VISTA DEL COMPRADOR (CONSULTA PÚBLICA SIN CREDENCIALES):&#xa;* Muestra: Estado del saco, hash anonimizado HMAC-SHA-256, departamento, altitud y puntaje SCA.&#xa;* Oculta estrictamente: Cédula caficultor, nombre, teléfono y coordenadas GPS submétricas.&#xa;&#xa;DECISIÓN FINOPS EN SISTEMA DE DISEÑO:&#xa;* Tokens W3C JSON centralizados y activos SVG nativos menores a 3 KB.&#xa;* Evita 180 GB mensuales de egress CloudFront y previene costos de reproceso de sacos ($3.500 USD/año)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#135E34;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="gov-card">
          <mxGeometry x="15" y="35" width="765" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
