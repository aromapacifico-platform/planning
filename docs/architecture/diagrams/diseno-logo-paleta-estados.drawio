        <!-- SECUNDARIO CEREZA -->
        <mxCell id="pal-cherry" value="ROJO CEREZA MADURA&#xa;Secundario Cultivo&#xa;&#xa;HEX: #9E1B1B&#xa;RGB: (158, 27, 27)&#xa;Contraste: 6.44:1&#xa;Clasificación: WCAG AA / AAA&#xa;Uso: Alertas y maduración" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9E1B1B;strokeColor=#7F1D1D;strokeWidth=2;fontSize=12;align=center;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="box-palette">
