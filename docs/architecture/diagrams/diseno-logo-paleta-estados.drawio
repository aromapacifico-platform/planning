        <!-- SECUNDARIO PACIFICO -->
        <mxCell id="pal-pacific" value="AZUL PACÍFICO&#xa;Secundario Logística&#xa;&#xa;HEX: #0F4C81&#xa;RGB: (15, 76, 129)&#xa;Contraste: 7.78:1&#xa;Clasificación: WCAG AAA&#xa;Uso: Rutas y transporte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F4C81;strokeColor=#1E40AF;strokeWidth=2;fontSize=12;align=center;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="box-palette">
          <mxGeometry x="525" y="45" width="225" height="195" as="geometry" />
