        <mxCell id="r4c3" value="Historia del saco&#10;&#10;Persistir entrega idempotente&#10;No instalar infraestructura&#10;de la Federación en el puerto" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cfdae3;fontColor=#19324b;fontSize=20;fontStyle=0;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1">
