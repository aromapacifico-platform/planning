        <mxCell id="150" value="ATRIBUTOS PERMITIDOS Y VISIBLES (TABLA PUBLICA sacos_publicos)&#10;- Codigo canónico tokenizado: SACO-2026-CAU-7F3A9C12 (HMAC-SHA-256)&#10;- Departamento y Municipio de Origen: Cauca / Popayan (Indicacion Regional)&#10;- Variedad Botanica: Castillo / Colombia / Caturra / Geisha&#10;- Variables de Calidad y Secado: Humedad (11.8%), Temperatura (21 grados C)&#10;- Masa Nominal: 60.0 KG | Calificacion SCA: 86.5 pts (Specialty)&#10;- Estado Logistico Oficial: [ACEPTADO] | Entrega: Terminal Portuaria Buenaventura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;align=left;fontSize=12;fontColor=#14532D;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
