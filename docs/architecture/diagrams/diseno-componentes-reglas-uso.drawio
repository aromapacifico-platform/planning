        <mxCell id="143" value="2. REGLAS ERGONOMICAS DE USO EN CAMPO (BIOCLIMATICA Y MOTRICIDAD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;align=left;fontSize=14;fontStyle=1;fontColor=#0F172A;spacingLeft=15;" parent="1" vertex="1">
