        <mxCell id="149" value="3. TARJETA DE SACO DEL COMPRADOR: VISTA ANONIMIZADA (LEY 1581 DE 2012)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;align=left;fontSize=14;fontStyle=1;fontColor=#0F172A;spacingLeft=15;" parent="1" vertex="1">
          <mxGeometry x="900" y="605" width="860" height="35" as="geometry" />
