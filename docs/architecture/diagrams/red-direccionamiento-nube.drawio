        <mxCell id="sub-p-az2-s3" value="5. Subred Object Storage Endpoints (AZ b): 10.70.130.0/24 (251 IPs utilizables)&#xa;   Propósito: Enlace de alta disponibilidad hacia S3 Bucket y almacenamiento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#545B64;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-azb">
          <mxGeometry x="15" y="335" width="600" height="65" as="geometry" />
        </mxCell>

        <mxCell id="sub-p-az2-adm" value="6. Subred Administración y TGW (AZ b): 10.70.140.0/24 (251 IPs utilizables)&#xa;   Propósito: ENI secundaria Transit Gateway Attachment para balanceo y redundancia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#545B64;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-azb">
          <mxGeometry x="15" y="410" width="600" height="65" as="geometry" />
        </mxCell>

        <mxCell id="sub-p-az2-pub" value="7. Subred Consulta Pública del Saco (AZ b): 10.70.150.0/24 (251 IPs utilizables)&#xa;   Propósito: Nodo secundario ALB público para soporte de picos de 30 req/min." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#FBCA04;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-azb">
