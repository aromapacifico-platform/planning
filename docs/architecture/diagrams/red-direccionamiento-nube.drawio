        <!-- PANEL DERECHO INFERIOR: PRUEBAS (10.60.0.0/16) Y DESARROLLO (10.50.0.0/16) -->
        <mxCell id="box-vpc-test" value="CUENTA PRUEBAS (AromaPacifico-Test) - VPC Pruebas: 10.60.0.0/16 (us-east-1)" style="swimlane;startSize=30;horizontal=1;fillColor=#EAEDED;strokeColor=#1D76DB;strokeWidth=2;rounded=1;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1040" y="790" width="640" height="750" as="geometry" />
        </mxCell>

        <mxCell id="card-test-details" value="ESTRUCTURA DE SUBREDES EN AMBIENTE DE PRUEBAS (TEST)&#xa;&#xa;Zona us-east-1a (Primaria):&#xa;- 10.60.1.0/24: Ingreso de Telemetría (Pruebas de drenado 24h)&#xa;- 10.60.2.0/24: Ingreso de Objetos Dron (Simulación de vuelos)&#xa;- 10.60.10.0/24: Aplicación Backend (Homologación de umbrales)&#xa;- 10.60.20.0/24: Datos (DynamoDB Local / Staging tables)&#xa;- 10.60.30.0/24: Object Storage (Pruebas de retención)&#xa;- 10.60.40.0/24: Administración y TGW Attachment&#xa;- 10.60.50.0/24: Consulta Pública (Pruebas de carga 30 req/min)&#xa;&#xa;Zona us-east-1b (Secundaria / Redundancia):&#xa;- 10.60.101.0/24: Ingreso de Telemetría AZ-b&#xa;- 10.60.102.0/24: Ingreso de Objetos Dron AZ-b&#xa;- 10.60.110.0/24: Aplicación Backend AZ-b&#xa;- 10.60.120.0/24: Datos AZ-b&#xa;- 10.60.130.0/24: Object Storage AZ-b&#xa;- 10.60.140.0/24: Administración y TGW AZ-b&#xa;- 10.60.150.0/24: Consulta Pública AZ-b&#xa;&#xa;Objetivo: Homologación fiel de cargas 24/7 sin interferir en producción." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D76DB;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=12;fontColor=#232F3E;" vertex="1" parent="box-vpc-test">
          <mxGeometry x="20" y="45" width="600" height="680" as="geometry" />
        </mxCell>

        <mxCell id="box-vpc-dev" value="CUENTA DESARROLLO (AromaPacifico-Dev) - VPC Dev: 10.50.0.0/16 (us-east-1)" style="swimlane;startSize=30;horizontal=1;fillColor=#EAEDED;strokeColor=#0E8A16;strokeWidth=2;rounded=1;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1720" y="790" width="640" height="750" as="geometry" />
        </mxCell>

        <mxCell id="card-dev-details" value="ESTRUCTURA DE SUBREDES EN AMBIENTE DE DESARROLLO (DEV)&#xa;&#xa;Zona us-east-1a (Activa en Horario Laboral 08:00 - 18:00):&#xa;- 10.50.1.0/24: Ingreso de Telemetría (Prototipado de módulos IaC)&#xa;- 10.50.2.0/24: Ingreso de Objetos Dron (Pruebas de funciones Lambda)&#xa;- 10.50.10.0/24: Aplicación Backend (Depuración y refactorización)&#xa;- 10.50.20.0/24: Datos (Entorno de pruebas unitarias)&#xa;- 10.50.30.0/24: Object Storage (Buckets efímeros de prueba)&#xa;- 10.50.40.0/24: Administración y TGW Attachment Dev&#xa;- 10.50.50.0/24: Consulta Pública (Pruebas de UI/UX)&#xa;&#xa;Zona us-east-1b (Estructura espejo para pruebas IaC):&#xa;- 10.50.101.0/24 a 10.50.150.0/24&#xa;&#xa;Control FinOps Agresivo:&#xa;- Apagado automático fuera de jornada laboral (L-V 08:00 - 18:00).&#xa;- Ahorro nocturno y de fines de semana: consumo &lt; $50 USD/mes.&#xa;- Aislamiento total: Bloqueo de estado Terraform (.tfstate) independiente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8A16;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=12;fontColor=#232F3E;" vertex="1" parent="box-vpc-dev">
          <mxGeometry x="20" y="45" width="600" height="680" as="geometry" />
