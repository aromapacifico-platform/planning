        <mxCell id="sub-p-az1-data" value="4. Subred Capa de Datos (AZ a): 10.70.20.0/24 (251 IPs utilizables)&#xa;   Propósito: VPC Endpoints para DynamoDB, nodos de cache y bases transaccionales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D93F0B;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-aza">
          <mxGeometry x="15" y="260" width="600" height="65" as="geometry" />
        </mxCell>

        <mxCell id="sub-p-az1-s3" value="5. Subred Object Storage Endpoints (AZ a): 10.70.30.0/24 (251 IPs utilizables)&#xa;   Propósito: Gateway Endpoints S3 para fotos de drones y archivo histórico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#545B64;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-aza">
          <mxGeometry x="15" y="335" width="600" height="65" as="geometry" />
        </mxCell>

        <mxCell id="sub-p-az1-adm" value="6. Subred Administración y TGW (AZ a): 10.70.40.0/24 (251 IPs utilizables)&#xa;   Propósito: ENI Transit Gateway Attachment, puntos de enlace para túneles y soporte." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#545B64;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-aza">
          <mxGeometry x="15" y="410" width="600" height="65" as="geometry" />
        </mxCell>

        <mxCell id="sub-p-az1-pub" value="7. Subred Consulta Pública del Saco (AZ a): 10.70.50.0/24 (251 IPs utilizables)&#xa;   Propósito: Application Load Balancer público, API de consulta para compradores." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#FBCA04;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-aza">
          <mxGeometry x="15" y="485" width="600" height="65" as="geometry" />
        </mxCell>

        <!-- AZ-b Produccion -->
        <mxCell id="box-prod-azb" value="Zona de Disponibilidad: us-east-1b (Subredes Secundarias / Alta Disponibilidad)" style="swimlane;startSize=25;horizontal=1;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="box-vpc-prod">
          <mxGeometry x="670" y="50" width="630" height="565" as="geometry" />
        </mxCell>

        <mxCell id="sub-p-az2-ingest" value="1. Subred Ingreso Telemetría (AZ b): 10.70.101.0/24 (251 IPs utilizables)&#xa;   Propósito: ENIs redundantes Lambda Ingesta IoT, failover automático." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#1D76DB;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-azb">
