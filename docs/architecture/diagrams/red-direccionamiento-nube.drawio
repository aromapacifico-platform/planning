        </mxCell>

        <mxCell id="sub-p-az2-dron" value="2. Subred Ingreso Objetos Dron (AZ b): 10.70.102.0/24 (251 IPs utilizables)&#xa;   Propósito: Procesamiento redundante de imágenes multiespectrales y misiones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#1D76DB;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-azb">
          <mxGeometry x="15" y="110" width="600" height="65" as="geometry" />
        </mxCell>

        <mxCell id="sub-p-az2-app" value="3. Subred Aplicación Backend (AZ b): 10.70.110.0/24 (251 IPs utilizables)&#xa;   Propósito: Cómputo serverless de contingencia y balanceo de carga." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#0E8A16;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-azb">
