        <mxCell id="box-prod-aza" value="Zona de Disponibilidad: us-east-1a (Subredes Primarias)" style="swimlane;startSize=25;horizontal=1;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;rounded=1;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="box-vpc-prod">
          <mxGeometry x="20" y="50" width="630" height="565" as="geometry" />
