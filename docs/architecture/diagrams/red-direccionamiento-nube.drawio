        <mxCell id="sub-p-az2-data" value="4. Subred Capa de Datos (AZ b): 10.70.120.0/24 (251 IPs utilizables)&#xa;   Propósito: Conexión secundaria a almacenes y persistencia transaccional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D93F0B;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-azb">
          <mxGeometry x="15" y="260" width="600" height="65" as="geometry" />
