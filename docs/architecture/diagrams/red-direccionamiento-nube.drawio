        <mxCell id="sub-p-az1-ingest" value="1. Subred Ingreso Telemetría (AZ a): 10.70.1.0/24 (251 IPs utilizables)&#xa;   Propósito: ENIs de Lambda Ingesta IoT, balanceadores internos de telemetría." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#1D76DB;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-aza">
          <mxGeometry x="15" y="35" width="600" height="65" as="geometry" />
        </mxCell>

        <mxCell id="sub-p-az1-dron" value="2. Subred Ingreso Objetos Dron (AZ a): 10.70.2.0/24 (251 IPs utilizables)&#xa;   Propósito: Procesamiento de ortomosaicos, ENIs para funciones de visión IA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#1D76DB;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-aza">
          <mxGeometry x="15" y="110" width="600" height="65" as="geometry" />
