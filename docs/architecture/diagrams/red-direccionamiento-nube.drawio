        <mxCell id="sub-p-az1-app" value="3. Subred Aplicación Backend (AZ a): 10.70.10.0/24 (251 IPs utilizables)&#xa;   Propósito: Microservicios de negocio, registro de sacos, validación de umbrales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#0E8A16;fontSize=12;align=left;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="box-prod-aza">
